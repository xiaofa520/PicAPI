# Include these rules inside the server {} block for PicAPI.
# Nginx does not evaluate the project's .htaccess file.

# Never make runtime data, endpoint counters, or VCS metadata public.
location ~* ^/(?:database|storage|log|m/log|pc/log)(?:/|$) {
    deny all;
    return 403;
}

location ~ /\.(?:git|svn|hg)(?:/|$) {
    deny all;
    return 403;
}

# A second safeguard for database files and temporary runtime files should a
# custom deployment move them outside the standard directories.
location ~* \.(?:sqlite|sqlite3|db|jsonl|log|bak|lock|tmp)$ {
    deny all;
    return 403;
}

# These root files are UI design sources containing mock administration data;
# they are not part of the public application.
location ~ ^/[1-4]\.html$ {
    deny all;
    return 403;
}
