<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS compatibility configuration. PHP FastCGI/handler mapping remains the
  responsibility of the hosting environment; no machine-specific path is used.
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <add value="index.php" />
      </files>
    </defaultDocument>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="database" />
          <add segment="storage" />
          <add segment="log" />
          <add segment=".git" />
          <add segment=".svn" />
          <add segment=".hg" />
          <add segment="1.html" />
          <add segment="2.html" />
          <add segment="3.html" />
          <add segment="4.html" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
