<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <defaultDocument><files><clear /><add value="index.php" /></files></defaultDocument>
    <httpErrors existingResponse="PassThrough" />
    <rewrite>
      <rules>
        <rule name="Block setup code" stopProcessing="true">
          <match url="^setup\.txt$" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <rule name="PicAPI root entry" stopProcessing="true">
          <match url="^(?!index\.php$).*" />
          <action type="Rewrite" url="index.php" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
