<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS compatibility configuration. PHP FastCGI/handler mapping remains the
  responsibility of the hosting environment; no machine-specific path is used.
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <add value="index.php" />
      </files>
    </defaultDocument>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="database" />
          <add segment="storage" />
          <add segment="log" />
          <add segment=".git" />
          <add segment=".svn" />
          <add segment=".hg" />
          <add segment="src" />
          <add segment="templates" />
          <add segment="config" />
          <add segment="tests" />
          <add segment="bin" />
          <add segment="demos" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
    <rewrite>
      <rules>
        <rule name="Block uploaded image scripts" stopProcessing="true">
          <match url="^(?:pc|m)/img/(?![a-z0-9][a-z0-9_-]{0,48}/index\.php$).+\.(?:php[0-9]?|phtml|phar)(?:/|$)" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <rule name="PicAPI robots and sitemap" stopProcessing="true">
          <match url="^(robots|sitemap)\.(txt|xml)$" />
          <action type="Rewrite" url="{R:1}.php" appendQueryString="false" />
        </rule>
        <rule name="PicAPI random endpoint" stopProcessing="true">
          <match url="^(api/v1/random/?|favicon\.ico)$" />
          <action type="Rewrite" url="index.php" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
